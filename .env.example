# Optional: used only by the web development server's AI endpoint.
# The installed Android app uses its deterministic offline parser without an API key.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# Browser/PWA Google Sheets authorization only. Android uses the native
# AuthorizationClient and an Android OAuth client registered for
# com.amarsingh.daytrace plus the APK signing certificate SHA-1.
VITE_GOOGLE_CLIENT_ID=""
